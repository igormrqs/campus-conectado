{
  "expo": {
    "name": "Campus Conectado",
    "slug": "campus-conectado",
    "scheme": "campus-conectado",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/campus-icon.png",
    "web": {
      "favicon": "./assets/campus-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "package": "br.edu.campusconectado.demo",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F7F5EF"
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "496c6acc-6a5f-495b-8582-2915ddbd5840"
      }
    },
    "owner": "igormrqs"
  }
}
