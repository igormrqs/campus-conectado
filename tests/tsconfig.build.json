{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "..",
    "outDir": "./.build",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["../src/features/tasks/**/*.ts", "../src/design/date-utils.ts"],
  "exclude": ["../node_modules", "../src/features/tasks/storage.ts"]
}
